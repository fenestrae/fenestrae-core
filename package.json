{
  "name": "fenestrae",
  "version": "1.0.3",
  "type": "module",
  "license": "Apache-2.0",
  "description": "The desktop window management experience the web always needed.",
  "author": {
    "name": "Toni Raventós",
    "email": "fenestrae.ws@gmail.com"
  },
  "main": "./dist/fenestrae.cjs.js",
  "module": "./dist/fenestrae.es.js",
  "types": "./src/index.d.ts",
  "style": "./dist/fenestrae.css",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/fenestrae.es.js",
      "require": "./dist/fenestrae.cjs.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "src/index.d.ts"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "playground": "vite --config playground/vite.config.js",
    "playground:dist": "vite build && vite --config playground/vite.config.js --mode dist",
    "prepare": "husky"
  },
  "peerDependencies": {
    "clsx": "^2.1.1",
    "immer": "^10.0.0 || ^11.0.0",
    "prop-types": "^15.8.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-icons": "^5.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0",
    "uuid": "^10.0.0",
    "zustand": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "clsx": "^2.1.1",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "immer": "^11.1.18",
    "jsdom": "^29.1.1",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.1",
    "terser": "^5.49.2",
    "uuid": "^14.0.2",
    "vite": "^7.2.5",
    "vitest": "^4.1.11",
    "zustand": "^5.0.15"
  }
}
